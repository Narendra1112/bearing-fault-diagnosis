# Data (large raw/processed files — not tracked)
data/

# Trained model weights
models/*.pth
models/*.pkl
models/*.onnx
models/*.onnx.data

# Local prediction DB (SQLite, generated at runtime)
*.db

# Scratch / runtime logs
api_new.log
api_new_err.log
eval_final.log

# Virtual environment
venv/
.venv/

# Python bytecode
__pycache__/
*.pyc
*.pyo
*.pyd

# MLflow run artifacts
mlruns/

# Environment variables
.env

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
*.swo

# Jupyter checkpoints
.ipynb_checkpoints/

# Uvicorn logs (generated at runtime)
uvicorn.log
uvicorn_err.log
