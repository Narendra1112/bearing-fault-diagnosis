# ── Bearing Fault Diagnosis — Environment Variables ──────────────────────────
# Copy to .env and fill in values. Never commit .env to git.
# All variables are optional — defaults work for local development.
# ─────────────────────────────────────────────────────────────────────────────

# ── Environment ───────────────────────────────────────────────────────────────
# Options: development | staging | production
ENVIRONMENT=development

# Logging level (development auto-sets DEBUG)
# Options: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (dev): sqlite+aiosqlite:///./data/bearing_prod.db
# PostgreSQL (prod): postgresql+asyncpg://user:pass@host:5432/bearing_db
DATABASE_URL=sqlite+aiosqlite:///./data/bearing_prod.db

# ── Redis ─────────────────────────────────────────────────────────────────────
# Used for rate limiting and caching
REDIS_URL=redis://localhost:6379/0

# ── MLflow ────────────────────────────────────────────────────────────────────
MLFLOW_URI=./mlruns

# ── Model Paths ───────────────────────────────────────────────────────────────
MODEL_PATH=./models/best_cnn.pth
ONNX_MODEL_PATH=./models/best_cnn.onnx
TRAIN_DATA_PATH=./data/processed/train.npz
TEST_DATA_PATH=./data/processed/test.npz

# ── API Security ──────────────────────────────────────────────────────────────
# REQUIRED in production/staging — the app refuses to start without it.
# Leave empty in development and an ephemeral key is generated and logged at startup.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=

# CORS — comma-separated allowed origins (empty = same-origin only). Never "*".
# Example: CORS_ALLOWED_ORIGINS=http://localhost:3000,https://app.example.com
CORS_ALLOWED_ORIGINS=

# Model version label (surfaced in /models, metrics, and persisted predictions)
MODEL_VERSION=v1.0

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# Max requests per minute per API key
RATE_LIMIT_RPM=100

# ── Inference ─────────────────────────────────────────────────────────────────
MAX_BATCH_SIZE=32
SIGNAL_LENGTH=1024
INFERENCE_TIMEOUT_S=5.0
WARMUP_RUNS=10

# ── Drift Detection ───────────────────────────────────────────────────────────
DRIFT_ZSCORE_THRESHOLD=2.0
DRIFT_CUSUM_H=5.0
DRIFT_MMD_WINDOW=50
DRIFT_UNCERTAINTY_THRESHOLD=0.15

# ── Alerting ──────────────────────────────────────────────────────────────────
# Leave empty to disable webhook alerts
WEBHOOK_URL=
BEARING_HEALTH_ALERT_THRESHOLD=0.3

# ── Bearing Physics (SKF 6205-2RS JEM) ───────────────────────────────────────
# Do not change unless using a different bearing
BEARING_NB=9
BEARING_BD=0.3126
BEARING_PD=1.537
BEARING_CONTACT_ANGLE=0.0
BEARING_FS=12000.0
